        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TB\n    subgraph 输入层[\&quot;🖥️ 输入层\&quot;]\n        CLI[\&quot;💻 CLI 终端&lt;br/&gt;rag ask &#39;问题&#39;&lt;br/&gt;rag_cli/main.py\&quot;]\n        WebUI[\&quot;🌐 浏览器&lt;br/&gt;POST /api/chat&lt;br/&gt;Web UI (static/index.html)\&quot;]\n    end\n\n    subgraph 服务层[\&quot;🔌 服务层\&quot;]\n        App[\&quot;rag_server/app.py&lt;br/&gt;FastAPI create_app()&lt;br/&gt;路由: /api/chat, /api/status, /api/reindex\&quot;]\n        Chat[\&quot;rag_server/chat.py&lt;br/&gt;chat_stream()&lt;br/&gt;SSE 流式 + 会话历史管理\&quot;]\n    end\n\n    subgraph 核心层[\&quot;⚙️ 核心层 rag_core/\&quot;]\n        Pipeline[\&quot;retrieval/pipeline.py&lt;br/&gt;RAGPipeline&lt;br/&gt;.ask() / .ask_with_filter()\&quot;]\n        Embedder[\&quot;indexing/embedder.py&lt;br/&gt;create_embedder()&lt;br/&gt;BGE-M3 → 768维向量\&quot;]\n        Store[\&quot;indexing/store.py&lt;br/&gt;VectorStoreManager&lt;br/&gt;ChromaDB 向量检索\&quot;]\n        LLM[\&quot;llm/deepseek.py&lt;br/&gt;create_deepseek_llm()&lt;br/&gt;DeepSeek API 流式生成\&quot;]\n\n        subgraph 索引构建[\&quot;📦 索引构建\&quot;]\n            Watcher[\&quot;watcher.py&lt;br/&gt;VaultWatcher&lt;br/&gt;文件监控 + 增量同步\&quot;]\n            Loader[\&quot;indexing/loader.py&lt;br/&gt;ObsidianLoader&lt;br/&gt;解析 .md + frontmatter\&quot;]\n            Splitter[\&quot;indexing/splitter.py&lt;br/&gt;Parent-Child 分块&lt;br/&gt;## 标题切分\&quot;]\n        end\n    end\n\n    subgraph 配置层[\&quot;🔧 配置层\&quot;]\n        Config[\&quot;config.py&lt;br/&gt;Config dataclass&lt;br/&gt;.env → 全局配置\&quot;]\n    end\n\n    subgraph 输出层[\&quot;📤 输出层\&quot;]\n        TerminalOut[\&quot;终端逐字输出&lt;br/&gt;sys.stdout.write()\&quot;]\n        BrowserOut[\&quot;浏览器 SSE 流式&lt;br/&gt;EventSourceResponse\&quot;]\n    end\n\n    %% 输入 → 服务\n    CLI --&gt; App\n    WebUI --&gt; App\n\n    %% 服务 → 核心\n    App --&gt; Chat\n    Chat --&gt; Pipeline\n\n    %% 核心流程\n    Pipeline --&gt; Embedder\n    Embedder --&gt; Store\n    Store --&gt; Pipeline\n    Pipeline --&gt; LLM\n\n    %% 索引构建\n    Watcher --&gt; Loader\n    Loader --&gt; Splitter\n    Splitter --&gt; Embedder\n    Embedder --&gt; Store\n\n    %% 配置流向\n    Config -.-&gt; Embedder\n    Config -.-&gt; Store\n    Config -.-&gt; LLM\n    Config -.-&gt; App\n    Config -.-&gt; Watcher\n\n    %% 输出\n    Pipeline -.-&gt;|CLI 路径| TerminalOut\n    Chat -.-&gt;|Web 路径| BrowserOut\n\n    style 输入层 fill:#1a1a2e,stroke:#e94560,color:#fff\n    style 服务层 fill:#1a1a2e,stroke:#0f3460,color:#fff\n    style 核心层 fill:#1a1a2e,stroke:#16213e,color:#fff\n    style 索引构建 fill:#1a1a2e,stroke:#533483,color:#fff\n    style 配置层 fill:#1a1a2e,stroke:#e23e57,color:#fff\n    style 输出层 fill:#1a1a2e,stroke:#16c79a,color:#fff&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="41">
